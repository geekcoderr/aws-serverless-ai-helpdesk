# AWS Configuration
AWS_REGION=us-east-1

# Jira Configuration
# The domain of your Jira instance (e.g., yourcompany.atlassian.net)
JIRA_DOMAIN=yourcompany.atlassian.net

# The email address used to log into Jira and generate the API token
JIRA_EMAIL=admin@yourcompany.com

# The Atlassian API Token generated from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# The Project Key in Jira where tickets should be created (e.g., SUP, IT, GRIV)
JIRA_PROJECT_KEY=SUP

# SES Configuration (Auto-Responder)
# A verified identity in Amazon SES to act as the "From" address for automated replies
SENDER_EMAIL=support@yourcompany.com
